# File: .env.local.example
#
# Copy this file to .env.local and fill in your own key — .env.local is
# git-ignored and is only ever read on the server (src/app/api/feedback/route.ts),
# so the key is never sent to the browser.
#
#   cp .env.local.example .env.local

# Required for AI-powered oral practice feedback (src/app/api/feedback/route.ts).
# Get a key at https://console.anthropic.com/settings/keys
# Without this set, the app automatically falls back to the built-in
# keyword-matching feedback (see buildAutoFeedback in AudioAssignmentModule.tsx) —
# the app still works, just with simpler feedback.
ANTHROPIC_API_KEY=

# Optional: override the model used for feedback generation. Defaults to
# claude-opus-5. For a high-volume classroom deployment you may want a
# faster/cheaper model, e.g. claude-haiku-4-5.
ANTHROPIC_MODEL=
